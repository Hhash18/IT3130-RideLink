            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"actualDistanceKm\": 12, \"actualDurationMinutes\": 25}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"COMPLETED\", () => pm.expect(pm.response.json().status).to.eql(\"COMPLETED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Finalize fare",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/rides/{{rideId}}/fare",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Final price\", () => pm.expect(pm.response.json().finalFare).to.be.above(0));",
              "pm.environment.set(\"fareId\",pm.response.json().finalFareId);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Retry same fare",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/rides/{{rideId}}/fare",
        "auth": {
          "type": "bearer",
          "bearer": [
