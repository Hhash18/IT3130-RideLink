          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Same fare\", () => pm.expect(pm.response.json().finalFareId).to.eql(pm.environment.get(\"fareId\")));"
            ]
          }
        }
      ]
    },
