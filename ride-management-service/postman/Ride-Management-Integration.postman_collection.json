{
  "info": {
    "name": "RideLink Ride Management - Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requires aligned Account/Fare JWT contracts and an available vehicle-enabled driver whose signed email matches the lowest-ID eligible profile. Fill tokens locally."
  },
  "item": [
    {
      "name": "01 Swagger contract",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/v3/api-docs",
        "auth": {
          "type": "noauth"
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Authentication required",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rides",
        "auth": {
          "type": "noauth"
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/rides",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passengerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"pickup\": \"Colombo Fort\", \"destination\": \"Bambalapitiya\", \"serviceArea\": \"{{serviceArea}}\", \"estimatedDistanceKm\": 10, \"estimatedDurationMinutes\": 20}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"REQUESTED\", () => pm.expect(pm.response.json().status).to.eql(\"REQUESTED\"));",
              "pm.environment.set(\"rideId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Wrong passenger denied",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rides/{{rideId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{otherPassengerToken}}",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Invalid start denied",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/rides/{{rideId}}/start",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Assign driver",
