            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const ridelinkResult = pm.response.json();",
              "pm.test(\"Amount persisted\", () => { pm.expect(ridelinkResult.fare.total).to.eql(945); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Saved payment history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{fare_url}}/api/payments/rides/{{ride_id}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{passenger_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const ridelinkResult = pm.response.json();",
              "pm.test(\"Paid persisted\", () => { pm.expect(ridelinkResult.status).to.eql(\"PAID\"); });",
              "pm.test(\"Attempts persisted\", () => { pm.expect(ridelinkResult.attempts).to.have.length(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Saved receipt",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{fare_url}}/api/payments/{{payment_id}}/receipt",
        "auth": {
          "type": "bearer",
