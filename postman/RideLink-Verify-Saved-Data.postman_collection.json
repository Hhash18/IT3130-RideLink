              "pm.test(\"Still cancelled\", () => { pm.expect(ridelinkResult.status).to.eql(\"CANCELLED\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Saved fare",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
