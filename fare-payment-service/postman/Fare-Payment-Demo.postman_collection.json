      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Same payment\", () => pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"paymentId\")));"
            ]
          }
        }
      ]
    },
