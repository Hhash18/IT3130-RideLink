            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Reject other passenger",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/fares/rides/{{rideId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{otherPassengerUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Initially unpaid",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/payments/rides/{{rideId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{passengerUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"UNPAID\", () => pm.expect(pm.response.json().status).to.eql(\"UNPAID\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Simulated decline",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{declineKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments/rides/{{rideId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{passengerUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"method\": \"MOCK_CARD\", \"simulation\": \"DECLINED\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"FAILED\", () => pm.expect(pm.response.json().status).to.eql(\"FAILED\"));",
              "pm.environment.set(\"failedPaymentId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Failed payment has no receipt",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/payments/{{failedPaymentId}}/receipt",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{passengerUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Successful retry with new key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{successKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/payments/rides/{{rideId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{passengerUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"method\": \"MOCK_CARD\", \"simulation\": \"SUCCESS\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"SUCCEEDED\", () => pm.expect(pm.response.json().status).to.eql(\"SUCCEEDED\"));",
              "pm.environment.set(\"paymentId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Replay payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
