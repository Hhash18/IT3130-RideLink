{
  "info": {
    "name": "RideLink Fare & Payment - Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Member 4 only. Use a fresh demo database, fill demoPassword locally and run in order."
  },
  "item": [
    {
      "name": "01 Estimate fare",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/fares/estimate",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{passengerUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"pickup\": \"Colombo Fort\", \"destination\": \"Bambalapitiya\", \"distanceKm\": 10, \"durationMinutes\": 20}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"declineKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.environment.set(\"successKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"LKR 800\", () => pm.expect(pm.response.json().fare.total).to.eql(800));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Reject invalid estimate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/fares/estimate",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{passengerUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"pickup\": \"\", \"destination\": \"B\", \"distanceKm\": -1, \"durationMinutes\": 20}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Reject unfinished ride",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/api/fares/rides/{{activeRideId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Incomplete ride\", () => pm.expect(pm.response.json().code).to.eql(\"RIDE_NOT_COMPLETED\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Finalize completed ride",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/api/fares/rides/{{rideId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{demoPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Positive final fare\", () => pm.expect(pm.response.json().fare.total).to.be.above(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Retrieve own fare",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/fares/rides/{{rideId}}",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{passengerUser}}",
