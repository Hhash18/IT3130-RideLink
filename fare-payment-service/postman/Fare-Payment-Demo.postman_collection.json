              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"method\": \"CASH\", \"simulation\": \"SUCCESS\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"Already paid\", () => pm.expect(pm.response.json().code).to.eql(\"ALREADY_PAID\"));"
            ]
          }
        }
      ]
    }
  ]
